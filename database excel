CREATE DATABASE risk_ai;

USE risk_ai;

CREATE TABLE risks (
    id INT AUTO_INCREMENT PRIMARY KEY,
    process TEXT,
    risk TEXT,
    impact TEXT,
    mitigation TEXT,
    category VARCHAR(100)
);

CREATE TABLE users (
    id INT AUTO_INCREMENT PRIMARY KEY,
    username VARCHAR(100),
    password VARCHAR(255),
    role VARCHAR(50)
);

